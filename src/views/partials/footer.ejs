<footer class="bg-primary text-white/80 mt-24">
  <div class="container-page py-16 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="md:col-span-2">
      <img src="/images/logo-256.png" alt="<%= t('site.name') %>" class="h-20 w-20 object-contain mb-5" />
      <p class="max-w-sm text-sm leading-relaxed"><%= t('footer.about_text') %></p>
    </div>

    <div>
      <div class="eyebrow text-white/60 mb-4"><%= t('footer.quick_links') %></div>
      <ul class="space-y-2 text-sm">
        <li><a href="<%= basePath %>/about" class="hover:text-accent transition-colors duration-250"><%= t('nav.about') %></a></li>
        <li><a href="<%= basePath %>/projects" class="hover:text-accent transition-colors duration-250"><%= t('nav.projects') %></a></li>
        <li><a href="<%= basePath %>/news" class="hover:text-accent transition-colors duration-250"><%= t('nav.news') %></a></li>
        <li><a href="<%= basePath %>/contact" class="hover:text-accent transition-colors duration-250"><%= t('nav.contact') %></a></li>
      </ul>
    </div>

    <div>
      <div class="eyebrow text-white/60 mb-4"><%= t('footer.contact_info') %></div>
      <ul class="space-y-2 text-sm">
        <li>Tầng 20, Tòa nhà Đại Cát, Quận 1, TP. Hồ Chí Minh</li>
        <li>+84 28 1234 5678</li>
        <li>contact@daicatholdings.vn</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-6 text-xs text-white/50 flex flex-col md:flex-row justify-between gap-2">
      <span>&copy; <%= new Date().getFullYear() %> <%= t('site.name') %>. <%= t('footer.rights') %>.</span>
    </div>
  </div>
</footer>
