<form method="post" action="/admin/settings" class="space-y-6 max-w-xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div>
    <label class="form-label">Số điện thoại công ty</label>
    <input type="text" name="company_phone" class="form-input" value="<%= settings.company_phone || '' %>" />
  </div>
  <div>
    <label class="form-label">Email công ty</label>
    <input type="email" name="company_email" class="form-input" value="<%= settings.company_email || '' %>" />
  </div>
  <div>
    <label class="form-label">Địa chỉ văn phòng</label>
    <input type="text" name="company_address" class="form-input" value="<%= settings.company_address || '' %>" />
  </div>
  <div>
    <label class="form-label">Facebook</label>
    <input type="url" name="social_facebook" class="form-input" value="<%= settings.social_facebook || '' %>" />
  </div>
  <div>
    <label class="form-label">LinkedIn</label>
    <input type="url" name="social_linkedin" class="form-input" value="<%= settings.social_linkedin || '' %>" />
  </div>
  <button type="submit" class="btn-primary">Lưu cài đặt</button>
</form>
