<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Quản trị ĐẠI CÁT HOLDINGS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
</head>
<body class="min-h-screen bg-surface-muted flex">
  <aside class="w-64 bg-primary text-white/80 flex-shrink-0 min-h-screen p-6 hidden md:flex md:flex-col">
    <div class="font-display text-lg tracking-widest2 text-white mb-10">ĐẠI CÁT ADMIN</div>
    <nav class="space-y-1 flex-1">
      <a href="/admin" class="block px-3 py-2.5 text-sm hover:bg-white/10 transition-colors duration-250">Dashboard</a>
      <a href="/admin/projects" class="block px-3 py-2.5 text-sm hover:bg-white/10 transition-colors duration-250">Dự án</a>
      <a href="/admin/news" class="block px-3 py-2.5 text-sm hover:bg-white/10 transition-colors duration-250">Tin tức</a>
      <a href="/admin/inquiries" class="block px-3 py-2.5 text-sm hover:bg-white/10 transition-colors duration-250">Liên hệ</a>
      <a href="/admin/settings" class="block px-3 py-2.5 text-sm hover:bg-white/10 transition-colors duration-250">Cài đặt</a>
    </nav>
    <div class="border-t border-white/10 pt-4 mt-4">
      <p class="text-xs text-white/50 mb-3"><%= currentAdmin ? currentAdmin.name : '' %></p>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="text-xs tracking-widest2 uppercase text-white/70 hover:text-accent-light">Đăng xuất</button>
      </form>
    </div>
  </aside>

  <main class="flex-1 p-6 md:p-10 max-w-5xl">
    <% if (messages && messages.success && messages.success.length) { %>
      <div class="bg-primary text-white p-4 mb-8 text-sm"><%= messages.success[0] %></div>
    <% } %>
    <h1 class="font-display text-2xl text-primary mb-8"><%= title %></h1>
    <%- body %>
  </main>
</body>
</html>
