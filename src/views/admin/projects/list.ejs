<div class="flex justify-end mb-6">
  <a href="/admin/projects/new" class="btn-primary">+ Thêm dự án</a>
</div>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-surface-muted text-left text-xs uppercase tracking-widest2 text-ink-muted">
      <tr>
        <th class="px-4 py-3">Tên dự án</th>
        <th class="px-4 py-3">Loại hình</th>
        <th class="px-4 py-3">Trạng thái</th>
        <th class="px-4 py-3">Nổi bật</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% projects.forEach(p => { %>
        <tr class="border-t border-line">
          <td class="px-4 py-3 font-medium text-primary"><%= p.titleVi %></td>
          <td class="px-4 py-3"><%= p.type %></td>
          <td class="px-4 py-3"><%= p.status %></td>
          <td class="px-4 py-3"><%= p.isFeatured ? 'Có' : '—' %></td>
          <td class="px-4 py-3 text-right space-x-3">
            <a href="/admin/projects/<%= p.id %>/edit" class="text-accent hover:underline">Sửa</a>
            <form method="post" action="/admin/projects/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Xoá dự án này?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="text-red-600 hover:underline">Xoá</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (projects.length === 0) { %>
        <tr><td colspan="5" class="px-4 py-6 text-center text-ink-muted">Chưa có dự án nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
