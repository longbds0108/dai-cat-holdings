<div class="w-full max-w-sm px-6">
  <div class="text-center mb-10">
    <img src="/images/logo-256.png" alt="ĐẠI CÁT HOLDINGS" class="h-24 w-24 object-contain mx-auto mb-4" />
    <p class="text-white/50 text-xs tracking-widest2 uppercase">Quản trị nội dung</p>
  </div>

  <div class="bg-white p-8">
    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 p-3 mb-6 text-sm"><%= error %></div>
    <% } %>

    <form method="post" action="/admin/login" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div>
        <label class="form-label">Email</label>
        <input type="email" name="email" required class="form-input" autofocus />
      </div>
      <div>
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" required class="form-input" />
      </div>
      <button type="submit" class="btn-primary w-full">Đăng nhập</button>
    </form>
  </div>
</div>
