<link rel="stylesheet" href="/vendor/quill/quill.snow.css" />

<form method="post" action="<%= post ? `/admin/news/${post.id}` : '/admin/news' %>" enctype="multipart/form-data" class="space-y-8 max-w-3xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label class="form-label">Tiêu đề (Tiếng Việt)</label>
      <input type="text" name="titleVi" required class="form-input" value="<%= post ? post.titleVi : '' %>" />
    </div>
    <div>
      <label class="form-label">Title (English)</label>
      <input type="text" name="titleEn" required class="form-input" value="<%= post ? post.titleEn : '' %>" />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label class="form-label">Mô tả ngắn (Tiếng Việt)</label>
      <textarea name="excerptVi" rows="2" class="form-input"><%= post ? post.excerptVi : '' %></textarea>
    </div>
    <div>
      <label class="form-label">Excerpt (English)</label>
      <textarea name="excerptEn" rows="2" class="form-input"><%= post ? post.excerptEn : '' %></textarea>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label class="form-label">Nội dung (Tiếng Việt)</label>
      <div id="editor-content-vi" style="min-height:220px;background:#fff;"><%- post ? post.contentVi : '' %></div>
      <textarea name="contentVi" class="hidden" id="input-contentVi"></textarea>
    </div>
    <div>
      <label class="form-label">Content (English)</label>
      <div id="editor-content-en" style="min-height:220px;background:#fff;"><%- post ? post.contentEn : '' %></div>
      <textarea name="contentEn" class="hidden" id="input-contentEn"></textarea>
    </div>
  </div>

  <div>
    <label class="form-label">Ảnh đại diện</label>
    <input type="file" name="coverImage" accept="image/png,image/jpeg,image/webp" class="form-input" />
    <% if (post && post.coverImage) { %>
      <img src="<%= post.coverImage %>" class="w-32 h-32 object-cover mt-3" />
    <% } %>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <input type="checkbox" name="isPublished" <%= !post || post.isPublished ? 'checked' : '' %> /> Hiển thị công khai
  </label>

  <button type="submit" class="btn-primary">Lưu bài viết</button>
</form>

<script src="/vendor/quill/quill.js"></script>
<script src="/js/admin-editor.js"></script>
