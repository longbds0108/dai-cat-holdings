<section class="relative h-[50vh] min-h-[380px] flex items-end overflow-hidden">
  <img
    src="/images/projects/khu-nha-o-kim-kim-tran.webp"
    alt="<%= t('about.title') %>"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/50 to-primary/10"></div>
  <div class="relative container-page pb-16 text-white" data-reveal>
    <p class="eyebrow text-accent-light mb-4"><%= t('nav.about') %></p>
    <h1 class="font-display text-4xl md:text-6xl text-white"><%= t('about.title') %></h1>
  </div>
</section>

<section class="py-24">
  <div class="container-page max-w-3xl" data-reveal>
    <p class="eyebrow mb-4"><%= t('about.intro_eyebrow') %></p>
    <p class="text-lg leading-relaxed text-ink"><%= t('about.intro') %></p>
  </div>
</section>

<section class="py-24 bg-surface-muted">
  <div class="container-page grid grid-cols-1 md:grid-cols-2 gap-12" data-reveal-stagger>
    <div class="card p-10" data-reveal-item>
      <p class="eyebrow mb-4"><%= t('about.vision_title') %></p>
      <p class="text-ink leading-relaxed"><%= t('about.vision_text') %></p>
    </div>
    <div class="card p-10" data-reveal-item>
      <p class="eyebrow mb-4"><%= t('about.mission_title') %></p>
      <p class="text-ink leading-relaxed"><%= t('about.mission_text') %></p>
    </div>
  </div>
</section>

<section class="py-24 bg-primary text-white">
  <div class="container-page">
    <h2 class="section-title text-white text-center mb-16"><%= t('about.milestones_title') %></h2>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8" data-reveal-stagger>
      <% [1,2,3,4].forEach(i => { %>
        <div class="border-t-2 border-accent-light pt-6" data-reveal-item>
          <div class="font-display text-2xl text-accent-light mb-2"><%= t('about.core_value_' + i + '_title') %></div>
          <p class="text-sm text-white/70 leading-relaxed"><%= t('about.core_value_' + i + '_text') %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
