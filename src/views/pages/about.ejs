<section class="relative h-[50vh] min-h-[380px] flex items-end overflow-hidden">
  <img
    src="https://images.pexels.com/photos/1546168/pexels-photo-1546168.jpeg?auto=compress&cs=tinysrgb&w=1920"
    alt="<%= t('about.title') %>"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/50 to-primary/10"></div>
  <div class="relative container-page pb-16 text-white" data-reveal>
    <p class="eyebrow text-accent-light mb-4"><%= t('nav.about') %></p>
    <h1 class="font-display text-4xl md:text-6xl text-white"><%= t('about.title') %></h1>
  </div>
</section>

<section class="py-24">
  <div class="container-page max-w-3xl" data-reveal>
    <p class="text-lg leading-relaxed text-ink"><%= t('about.intro') %></p>
  </div>
</section>

<section class="py-24 bg-surface-muted">
  <div class="container-page grid grid-cols-1 md:grid-cols-2 gap-12" data-reveal-stagger>
    <div class="card p-10" data-reveal-item>
      <p class="eyebrow mb-4"><%= t('about.vision_title') %></p>
      <p class="text-ink leading-relaxed"><%= t('about.vision_text') %></p>
    </div>
    <div class="card p-10" data-reveal-item>
      <p class="eyebrow mb-4"><%= t('about.mission_title') %></p>
      <p class="text-ink leading-relaxed"><%= t('about.mission_text') %></p>
    </div>
  </div>
</section>

<section class="py-24">
  <div class="container-page">
    <h2 class="section-title text-center mb-16"><%= t('about.milestones_title') %></h2>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8" data-reveal-stagger>
      <% [1,2,3,4].forEach(i => { %>
        <div class="border-t-2 border-accent pt-6" data-reveal-item>
          <div class="font-display text-3xl text-accent mb-2"><%= t('about.milestone_' + i + '_year') %></div>
          <p class="text-sm text-ink-muted leading-relaxed"><%= t('about.milestone_' + i + '_text') %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="py-24 bg-primary text-white">
  <div class="container-page">
    <h2 class="section-title text-white text-center mb-16"><%= t('about.team_title') %></h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10" data-reveal-stagger>
      <% const teamPhotos = [271816, 439227, 1396122]; %>
      <% [1,2,3].forEach((i, idx) => { %>
        <div class="text-center" data-reveal-item>
          <div class="aspect-square overflow-hidden mb-5 mx-auto max-w-[220px]">
            <img
              src="https://images.pexels.com/photos/<%= teamPhotos[idx] %>/pexels-photo-<%= teamPhotos[idx] %>.jpeg?auto=compress&cs=tinysrgb&w=600"
              alt="Leadership"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs text-accent-light tracking-widest2 uppercase"><%= t('about.team_' + i + '_role') %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
