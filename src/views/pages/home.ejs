<section class="relative h-[92vh] min-h-[620px] flex items-end overflow-hidden">
  <img
    src="https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&w=1920"
    alt="<%= t('home.hero_title') %>"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/40 to-primary/10"></div>
  <div
    class="absolute inset-0 opacity-90"
    style="background: linear-gradient(115deg, rgba(28,25,23,0.92) 0%, rgba(28,25,23,0.55) 32%, transparent 55%);"
  ></div>

  <div class="relative container-page pb-32 text-white" data-reveal>
    <p class="eyebrow text-accent-light mb-4"><%= t('site.tagline') %></p>
    <h1 class="font-display text-4xl md:text-6xl lg:text-7xl leading-[1.1] max-w-3xl text-white mb-6">
      <%= t('home.hero_title') %>
    </h1>
    <p class="max-w-xl text-white/80 mb-10"><%= t('home.hero_subtitle') %></p>
    <a href="<%= basePath %>/projects" class="btn-primary rounded-full bg-accent hover:bg-white hover:text-primary">
      <%= t('home.hero_cta') %>
    </a>
  </div>
</section>

<section class="relative z-10 -mt-16 md:-mt-20">
  <div class="container-page">
    <div class="bg-primary rounded-3xl shadow-2xl px-8 py-10 md:px-14 md:py-12" data-reveal-stagger>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        <div data-reveal-item>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent-light mb-5">
            <path d="M12 2 3 7v6c0 5 4 8.5 9 9 5-.5 9-4 9-9V7l-9-5Z" stroke-linejoin="round" />
            <path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h3 class="text-white font-display text-lg mb-2"><%= t('home.why_1_title') %></h3>
          <p class="text-white/60 text-sm leading-relaxed"><%= t('home.why_1_text') %></p>
        </div>
        <div data-reveal-item>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent-light mb-5">
            <path d="M12 21s7-7.58 7-12a7 7 0 1 0-14 0c0 4.42 7 12 7 12Z" stroke-linejoin="round" />
            <circle cx="12" cy="9" r="2.5" />
          </svg>
          <h3 class="text-white font-display text-lg mb-2"><%= t('home.why_2_title') %></h3>
          <p class="text-white/60 text-sm leading-relaxed"><%= t('home.why_2_text') %></p>
        </div>
        <div data-reveal-item>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent-light mb-5">
            <circle cx="12" cy="12" r="9" />
            <path d="m15 9-2 5-5 2 2-5 5-2Z" stroke-linejoin="round" />
          </svg>
          <h3 class="text-white font-display text-lg mb-2"><%= t('home.why_3_title') %></h3>
          <p class="text-white/60 text-sm leading-relaxed"><%= t('home.why_3_text') %></p>
        </div>
        <div data-reveal-item>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent-light mb-5">
            <path d="M4 13v-1a8 8 0 0 1 16 0v1" stroke-linecap="round" />
            <rect x="3" y="13" width="4" height="6" rx="1.2" />
            <rect x="17" y="13" width="4" height="6" rx="1.2" />
          </svg>
          <h3 class="text-white font-display text-lg mb-2"><%= t('home.why_4_title') %></h3>
          <p class="text-white/60 text-sm leading-relaxed"><%= t('home.why_4_text') %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pt-20 pb-8">
  <div class="container-page grid grid-cols-2 md:grid-cols-4 gap-8 text-center" data-reveal-stagger>
    <div data-reveal-item>
      <div class="font-display text-4xl md:text-5xl text-accent mb-2"><span data-counter="15">0</span>+</div>
      <p class="text-xs tracking-widest2 uppercase text-ink-muted"><%= t('stats.years') %></p>
    </div>
    <div data-reveal-item>
      <div class="font-display text-4xl md:text-5xl text-accent mb-2"><span data-counter="32">0</span></div>
      <p class="text-xs tracking-widest2 uppercase text-ink-muted"><%= t('stats.projects') %></p>
    </div>
    <div data-reveal-item>
      <div class="font-display text-4xl md:text-5xl text-accent mb-2"><span data-counter="850000">0</span></div>
      <p class="text-xs tracking-widest2 uppercase text-ink-muted"><%= t('stats.area') %></p>
    </div>
    <div data-reveal-item>
      <div class="font-display text-4xl md:text-5xl text-accent mb-2"><span data-counter="5000">0</span>+</div>
      <p class="text-xs tracking-widest2 uppercase text-ink-muted"><%= t('stats.customers') %></p>
    </div>
  </div>
</section>

<section class="py-24">
  <div class="container-page">
    <div class="flex items-end justify-between mb-12" data-reveal>
      <div>
        <p class="eyebrow mb-3"><%= t('nav.projects') %></p>
        <h2 class="section-title"><%= t('home.featured_projects') %></h2>
      </div>
      <a href="<%= basePath %>/projects" class="nav-link hidden md:inline-flex border-b border-primary pb-1">
        <%= t('home.featured_projects_cta') %>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-reveal-stagger>
      <% featuredProjects.forEach(project => { %>
        <%- include('../partials/project-card', { project, localize: (r,f) => localize(r,f) }) %>
      <% }) %>
    </div>
  </div>
</section>

<section class="py-24 bg-surface-muted">
  <div class="container-page">
    <div class="text-center max-w-xl mx-auto mb-14" data-reveal>
      <p class="eyebrow mb-3"><%= t('home.property_types_eyebrow') %></p>
      <h2 class="section-title"><%= t('home.property_types_title') %></h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger>
      <div class="rounded-3xl p-8 bg-accent text-white" data-reveal-item>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-6">
          <rect x="6" y="3" width="12" height="18" rx="1" />
          <path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1" stroke-linecap="round" />
        </svg>
        <h3 class="font-display text-xl mb-2 text-white"><%= t('home.type_1_title') %></h3>
        <p class="text-white/80 text-sm leading-relaxed"><%= t('home.type_1_text') %></p>
      </div>

      <div class="rounded-3xl p-8 bg-primary text-white" data-reveal-item>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-6 text-accent-light">
          <path d="M3 11 12 4l9 7" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M5 10v10h14V10" />
          <path d="M9 20v-6h6v6" />
        </svg>
        <h3 class="font-display text-xl mb-2 text-white"><%= t('home.type_2_title') %></h3>
        <p class="text-white/70 text-sm leading-relaxed"><%= t('home.type_2_text') %></p>
      </div>

      <div class="rounded-3xl p-8 card" data-reveal-item>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-6 text-accent">
          <rect x="8" y="2" width="8" height="20" rx="1" />
          <path d="M11 6h2M11 10h2M11 14h2M11 18h2" stroke-linecap="round" />
        </svg>
        <h3 class="font-display text-xl mb-2 text-primary"><%= t('home.type_3_title') %></h3>
        <p class="text-ink-muted text-sm leading-relaxed"><%= t('home.type_3_text') %></p>
      </div>

      <div class="rounded-3xl overflow-hidden aspect-[4/3] sm:aspect-auto" data-reveal-item>
        <img
          src="https://images.pexels.com/photos/1546168/pexels-photo-1546168.jpeg?auto=compress&cs=tinysrgb&w=900"
          alt="<%= t('home.property_types_title') %>"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="rounded-3xl p-8 bg-primary text-white" data-reveal-item>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-6 text-accent-light">
          <rect x="3" y="3" width="18" height="18" rx="1" />
          <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
        </svg>
        <h3 class="font-display text-xl mb-2 text-white"><%= t('home.type_5_title') %></h3>
        <p class="text-white/70 text-sm leading-relaxed"><%= t('home.type_5_text') %></p>
      </div>

      <div class="rounded-3xl p-8 card" data-reveal-item>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-6 text-accent">
          <path d="M3 9 5 4h14l2 5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4 9v11h16V9" />
          <path d="M9 20v-6h6v6" />
        </svg>
        <h3 class="font-display text-xl mb-2 text-primary"><%= t('home.type_6_title') %></h3>
        <p class="text-ink-muted text-sm leading-relaxed"><%= t('home.type_6_text') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-24">
  <div class="container-page">
    <div class="flex items-end justify-between mb-12" data-reveal>
      <div>
        <p class="eyebrow mb-3"><%= t('nav.news') %></p>
        <h2 class="section-title"><%= t('home.latest_news') %></h2>
      </div>
      <a href="<%= basePath %>/news" class="nav-link hidden md:inline-flex border-b border-primary pb-1">
        <%= t('home.latest_news_cta') %>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-reveal-stagger>
      <% latestNews.forEach(post => { %>
        <%- include('../partials/news-card', { post, localize: (r,f) => localize(r,f) }) %>
      <% }) %>
    </div>
  </div>
</section>

<section class="py-24 bg-surface-muted">
  <div class="container-page text-center max-w-2xl mx-auto" data-reveal>
    <h2 class="section-title mb-4"><%= t('home.cta_title') %></h2>
    <p class="text-ink-muted mb-10"><%= t('home.cta_subtitle') %></p>
    <a href="<%= basePath %>/contact" class="btn-primary rounded-full"><%= t('home.cta_button') %></a>
  </div>
</section>
