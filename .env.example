# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string
CSRF_SECRET=change-this-to-another-long-random-string

# Database
# DB_DIALECT=mysql (production/cPanel) | sqlite (local dev, no server needed)
DB_DIALECT=sqlite
DB_STORAGE=./database/dev.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=daicat_holdings
DB_USER=daicat_user
DB_PASSWORD=

# Default admin account (used by the seeder, change password after first login)
ADMIN_EMAIL=admin@daicatholdings.vn
ADMIN_PASSWORD=change-this-password

# Mail (SMTP - used for contact form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ĐẠI CÁT HOLDINGS <no-reply@daicatholdings.vn>"
MAIL_TO=contact@daicatholdings.vn
